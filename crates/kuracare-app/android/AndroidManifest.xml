<?xml version="1.0" encoding="utf-8"?>
<!-- Release manifest for Kuracare, used by scripts/apk-release.sh in place of
     the one generated by dx. Differences from the generated one, on purpose:
     - INTERNET is needed ONLY because Dioxus talks to the WebView over a websocket
       on 127.0.0.1 (Android requires it even for loopback sockets). The network
       security config allows cleartext only to 127.0.0.1 and trusts no CA; the
       page CSP allows connections only to 127.0.0.1; the core has no network code;
       scripts/check-network.sh verifies on the phone that no traffic leaves;
     - allowBackup=false and data extraction rules: no cloud or device-transfer backup;
     - invitations (tappa 4): POST_NOTIFICATIONS (asked when the user turns them on),
       RECEIVE_BOOT_COMPLETED (re-arm after a reboot); inexact alarms, so no
       SCHEDULE_EXACT_ALARM. singleTask: a notification reopens the running app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <!-- The system WebView must not call Google services on its own. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity android:configChanges="orientation|screenLayout|screenSize|keyboardHidden" android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name="org.kuracare.app.InviteReceiver" android:exported="false" />
        <receiver android:name="org.kuracare.app.RestartReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
