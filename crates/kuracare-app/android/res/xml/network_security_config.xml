<?xml version="1.0" encoding="utf-8"?>
<!-- Dioxus needs a websocket on 127.0.0.1 between Rust and the WebView.
     Everything else: no cleartext, and no trusted certificate authority,
     so no TLS connection can succeed either. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
